# ==============================================================================
# FarmEasy Backend Environment Configuration Template
# Copy this file to .env and configure with your actual credentials
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Aiven MySQL)
DB_HOST=farmeasy-mysql-farmeasy-03.f.aivencloud.com
DB_PORT=15250
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password_here
DB_NAME=defaultdb

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Payment Gateway (Cashfree)
CASHFREE_CLIENT_ID=your_cashfree_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret
CASHFREE_ENV=sandbox

# AWS S3 Storage (Product & Profile Uploads)
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Email Notification System (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Google Translate API
GOOGLE_PROJECT_ID=your_google_project_id
GOOGLE_CREDENTIALS_FILE=./farmeasy-key.json
